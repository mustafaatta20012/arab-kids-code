# ==============================================================================
# ARAB KIDS CODE - PRODUCTION & DEVELOPMENT ENVIRONMENT CONFIGURATION
# ==============================================================================
# IMPORTANT:
# 1. Never commit real credentials or .env files to Git.
# 2. In production, generate strong random strings for all secrets:
#    Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=production                       # 'development' | 'production' | 'test'
PORT=5000
API_PREFIX=/api/v1
CLIENT_URL=https://arabkidscode.com       # Your production frontend domain
ALLOWED_ORIGINS=https://arabkidscode.com,https://www.arabkidscode.com

# ------------------------------------------------------------------------------
# 2. MANAGED DATABASE (MONGODB ATLAS)
# ------------------------------------------------------------------------------
# Pattern: mongodb+srv://<db_user>:<db_password>@<cluster-host>/arab_kids_code?retryWrites=true&w=majority
# Make sure:
#  - Dedicated user with 'readWrite' role on 'arab_kids_code' only (NOT atlasAdmin)
#  - Network IP Access list is limited to your server's IP address
MONGODB_URI=mongodb+srv://app_user:YourStrongDbPassword123@cluster0.xxxxx.mongodb.net/arab_kids_code?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. INITIAL ADMIN / TEACHER SEEDING CREDENTIALS
# ------------------------------------------------------------------------------
# Used by: npm run seed:admin
# The script creates or updates the teacher account without dropping database collections.
ADMIN_EMAIL=teacher@arabkidscode.com
ADMIN_PASSWORD=ChangeThisToStrongPassword123!
ADMIN_NAME="م. مصطفى عطا"
ADMIN_PHONE=+201101587881

# ------------------------------------------------------------------------------
# 4. JWT & SESSION SECRETS (MINIMUM 32 CHARACTERS)
# ------------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=your_long_random_jwt_access_secret_32_characters_minimum_hex_key
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=your_long_random_jwt_refresh_secret_32_characters_minimum_hex_key
JWT_REFRESH_EXPIRATION=7d
COOKIE_SECRET=your_long_random_cookie_signing_secret_32_chars_minimum_hex_key
FRONTEND_SECURE_COOKIE=true               # Must be true in HTTPS production

# ------------------------------------------------------------------------------
# 5. INSTRUCTOR & PLATFORM CONTACT (WHATSAPP CTA & SUPPORT)
# ------------------------------------------------------------------------------
INSTRUCTOR_NAME="م. مصطفى عطا"
INSTRUCTOR_PHONE=+201101587881
INSTRUCTOR_WHATSAPP=+201101587881
SUPPORT_EMAIL=support@arabkidscode.com

# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL EMAIL (SMTP / RESEND / SENDGRID)
# ------------------------------------------------------------------------------
# Used for welcome messages, payment receipts, and password reset links
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_smtp_api_password_here
EMAIL_FROM="كود أطفال العرب <noreply@arabkidscode.com>"

# ------------------------------------------------------------------------------
# 7. REDIS CACHE (OPTIONAL FOR CLUSTERING / ADVANCED RATE LIMITING)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 8. RATE LIMITING & SECURITY SETTINGS
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000               # 15 minutes
RATE_LIMIT_MAX=300                        # Max requests per window
AUTH_RATE_LIMIT_MAX=10                    # Stricter for login/register/reset
