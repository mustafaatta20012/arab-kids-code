{
  "name": "arab-kids-code-monorepo",
  "private": true,
  "version": "2.0.0",
  "description": "Arab Kids Code – Firebase-only educational platform (Spark plan)",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev":          "npm run dev --workspace=apps/web",
    "build":        "npm run build --workspace=apps/web",
    "preview":      "npm run preview --workspace=apps/web",
    "lint":         "npm run lint --workspace=apps/web",
    "typecheck":    "npm run typecheck --workspace=apps/web",
    "deploy":       "npm run build && firebase deploy --only hosting,firestore",
    "emulate":      "firebase emulators:start --only hosting,firestore,auth",
    "format":       "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\""
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "firebase-tools": "^14.0.0",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  }
}
