rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ───────────────────────────────────────────────────

    function isLoggedIn() {
      return request.auth != null;
    }

    // Read role from Firestore document (NO custom claims needed)
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isLoggedIn() && (
        getUserRole() == 'teacher' ||
        getUserRole() == 'super_admin'
      );
    }

    function isOwner(userId) {
      return isLoggedIn() && request.auth.uid == userId;
    }

    function isValidString(val, maxLen) {
      return val is string && val.size() > 0 && val.size() <= maxLen;
    }

    // ── Courses: public read, admin write ──────────────────────────────────
    match /courses/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Lessons: public read for isPublic, auth read for others ───────────
    match /lessons/{lessonId} {
      allow read: if resource == null || resource.data.isPublic == true || isLoggedIn();
      allow write: if isAdmin();
    }

    // ── Reviews: approved public read, public create with validation ───────
    match /reviews/{reviewId} {
      allow read: if resource == null || resource.data.status == 'approved' || isAdmin();

      allow create: if
        request.resource.data.keys().hasAll(['authorName', 'rating', 'comment', 'status', 'createdAt']) &&
        request.resource.data.status == 'pending' &&
        isValidString(request.resource.data.authorName, 100) &&
        isValidString(request.resource.data.comment, 500) &&
        request.resource.data.rating is number &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5;

      allow update, delete: if isAdmin();
    }

    // ── Contacts: public create only, admin reads/manages ─────────────────
    match /contacts/{contactId} {
      allow create: if
        request.resource.data.keys().hasAll(['name', 'phone', 'message', 'createdAt']) &&
        isValidString(request.resource.data.name, 100) &&
        isValidString(request.resource.data.phone, 20) &&
        isValidString(request.resource.data.message, 1000);

      allow read, update, delete: if isAdmin();
    }

    // ── Users: full rules ──────────────────────────────────────────────────
    match /users/{userId} {

      // Admin: can query (list) the whole collection AND read individual docs
      allow list:   if isAdmin();
      allow get:    if isOwner(userId) || isAdmin();

      // Any logged-in user can create their own document on registration
      allow create: if
        isLoggedIn() &&
        request.auth.uid == userId;

      // Owner: can update own profile (but NOT role / approved / approvalStatus)
      // Admin: can update any field
      allow update: if
        isAdmin() ||
        (isOwner(userId) &&
         !('role' in request.resource.data.diff(resource.data).affectedKeys()) &&
         !('approved' in request.resource.data.diff(resource.data).affectedKeys()) &&
         !('approvalStatus' in request.resource.data.diff(resource.data).affectedKeys()));

      allow delete: if isAdmin();
    }

    // ── Students: parent manages own children, admin reads all ─────────────
    match /students/{studentId} {
      allow list: if isAdmin();
      allow get: if
        isLoggedIn() &&
        (resource == null || resource.data.parentId == request.auth.uid || isAdmin());

      allow create: if
        isLoggedIn() &&
        request.resource.data.parentId == request.auth.uid;

      allow update: if
        isAdmin() ||
        (isLoggedIn() && resource.data.parentId == request.auth.uid);

      allow delete: if isAdmin();
    }

    // ── Progress: owner reads/writes own ──────────────────────────────────
    match /progress/{docId} {
      allow read: if
        isLoggedIn() &&
        (resource == null || resource.data.userId == request.auth.uid);

      allow write: if
        isLoggedIn() &&
        request.resource.data.userId == request.auth.uid;
    }

    // ── Submissions: student creates/reads own, admin manages all ──────────
    match /submissions/{subId} {
      allow list: if isAdmin();
      allow get: if
        isLoggedIn() &&
        (resource == null || resource.data.studentId == request.auth.uid || isAdmin());

      allow create: if
        isLoggedIn() &&
        request.resource.data.studentId == request.auth.uid &&
        request.resource.data.status == 'pending';

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Audit logs: admin only ─────────────────────────────────────────────
    match /auditLogs/{logId} {
      allow list, get: if isAdmin();
      allow create:    if isAdmin();
      allow update, delete: if false;
    }

    // ── Deny everything else ──────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
