rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ────────────────────────────────────────────────────
    // NOTE: each get() call costs 1 Firestore read from quota.
    // We cache the user doc lookup via the pattern below.
    // Total extra reads per request: 1 (for isAdmin/isActive checks).

    function isLoggedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isLoggedIn() && (
        userDoc().role == 'teacher' || userDoc().role == 'super_admin'
      );
    }

    /** Active account — status field OR legacy approved:true fallback */
    function isActive() {
      return isLoggedIn() && (
        userDoc().status == 'active' ||
        (userDoc().status == null && userDoc().approved == true)
      );
    }

    function isOwner(userId) {
      return isLoggedIn() && request.auth.uid == userId;
    }

    function isValidString(val, maxLen) {
      return val is string && val.size() > 0 && val.size() <= maxLen;
    }

    // ── Protected fields that users CANNOT change themselves ─────────────
    function noProtectedFieldsChanged() {
      return !('status'      in request.resource.data.diff(resource.data).affectedKeys())
          && !('role'        in request.resource.data.diff(resource.data).affectedKeys())
          && !('approved'    in request.resource.data.diff(resource.data).affectedKeys())
          && !('approvedAt'  in request.resource.data.diff(resource.data).affectedKeys())
          && !('approvedBy'  in request.resource.data.diff(resource.data).affectedKeys())
          && !('approvalStatus' in request.resource.data.diff(resource.data).affectedKeys());
    }

    // ── Courses: public read, admin write ──────────────────────────────────
    match /courses/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Lessons ────────────────────────────────────────────────────────────
    // Public metadata (title, thumbnail, order, xpReward, durationMin, isFree)
    // is readable by everyone — so the curriculum page can list locked lessons.
    // Full lesson content (videoUrl, resources, scratchProjectUrl) is readable
    // only by active users or admins.
    //
    // To enforce this, store public fields in a subcollection or use Security
    // Rules field-level. Since Firestore can't do field-level on reads, the
    // recommended pattern is: keep a /lessons/{id} doc with only public metadata,
    // and store full content in /lessons/{id}/content/data (subcollection).
    //
    // Current implementation: full doc readable only by active/admin.
    // Public listing uses the fallback30Lessons array in CurriculumPage.
    match /lessons/{lessonId} {
      allow read:  if isActive() || isAdmin();
      allow write: if isAdmin();

      // Lesson content subcollection (videos, resources, etc.)
      match /content/{contentId} {
        allow read:  if isActive() || isAdmin();
        allow write: if isAdmin();
      }
    }

    // ── Reviews ────────────────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if resource == null || resource.data.status == 'approved' || isAdmin();

      allow create: if
        request.resource.data.keys().hasAll(['authorName', 'rating', 'comment', 'status', 'createdAt']) &&
        request.resource.data.status == 'pending' &&
        isValidString(request.resource.data.authorName, 100) &&
        isValidString(request.resource.data.comment, 500) &&
        request.resource.data.rating is number &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5;

      allow update, delete: if isAdmin();
    }

    // ── Contacts ───────────────────────────────────────────────────────────
    match /contacts/{contactId} {
      allow create: if
        request.resource.data.keys().hasAll(['name', 'phone', 'message', 'createdAt']) &&
        isValidString(request.resource.data.name, 100) &&
        isValidString(request.resource.data.phone, 20) &&
        isValidString(request.resource.data.message, 1000);

      allow read, update, delete: if isAdmin();
    }

    // ── Users ──────────────────────────────────────────────────────────────
    match /users/{userId} {

      // Admin: full read (list + get)
      allow list: if isAdmin();
      allow get:  if isOwner(userId) || isAdmin();

      // Any authenticated user can create their own profile doc on registration
      allow create: if isLoggedIn() && request.auth.uid == userId;

      // Admin: can update any field.
      // Owner: can update safe fields only — NOT status/role/approved/approvedAt/approvedBy/approvalStatus.
      allow update: if
        isAdmin() ||
        (isOwner(userId) && noProtectedFieldsChanged());

      allow delete: if isAdmin();
    }

    // ── Students ───────────────────────────────────────────────────────────
    match /students/{studentId} {
      allow list: if isAdmin();
      allow get: if
        isLoggedIn() &&
        (resource == null || resource.data.parentId == request.auth.uid || isAdmin());

      allow create: if
        isLoggedIn() && request.resource.data.parentId == request.auth.uid;

      allow update: if
        isAdmin() ||
        (isLoggedIn() && resource.data.parentId == request.auth.uid);

      allow delete: if isAdmin();
    }

    // ── Progress ────────────────────────────────────────────────────────────
    match /progress/{docId} {
      allow read: if
        isLoggedIn() &&
        (resource == null || resource.data.userId == request.auth.uid || isAdmin());

      allow write: if
        isActive() && request.resource.data.userId == request.auth.uid;
    }

    // ── Submissions ─────────────────────────────────────────────────────────
    match /submissions/{subId} {
      allow list: if isAdmin();
      allow get: if
        isLoggedIn() &&
        (resource == null || resource.data.studentId == request.auth.uid || isAdmin());

      allow create: if
        isActive() &&
        request.resource.data.studentId == request.auth.uid &&
        request.resource.data.status == 'pending';

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Audit logs ──────────────────────────────────────────────────────────
    match /auditLogs/{logId} {
      allow list, get: if isAdmin();
      allow create:    if isAdmin();
      allow update, delete: if false;
    }

    // ── In-app notifications (optional) ────────────────────────────────────
    // Admin writes to notifications/{uid}/items/{notifId}
    // User reads only their own notifications
    match /notifications/{userId}/items/{notifId} {
      allow read:   if isOwner(userId);
      allow create: if isAdmin();
      allow update: if isOwner(userId); // mark as read
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ── Deny everything else ────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
